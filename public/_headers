# Arquivos do build têm hash no nome: podem ficar no cache do navegador por 1 ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O service worker precisa ser conferido a cada visita, senão atualizações do app demoram a chegar.
/sw.js
  Cache-Control: no-cache

# Contrato do site no ar, lido pelo aviso de atualização: sempre o do último deploy.
/version.json
  Cache-Control: no-cache

# Proteções em todas as respostas (auditoria F15).
# - frame-ancestors/X-Frame-Options: o site não abre dentro de iframe de outro domínio.
# - Content-Security-Policy: scripts só do próprio site; rede só o site e o Supabase; imagens de
#   qualquer https (fotos de receita). O `vite preview` usa estes mesmos cabeçalhos (vite.config.ts),
#   então os testes de tela (npx playwright test) acusam o que a política bloquear. Ao usar um
#   serviço novo no navegador (script, fonte, API), inclua o domínio aqui.
#   cloudflareinsights.com: Web Analytics da Cloudflare, injetado só no site publicado (não aparece
#   nos testes locais; conferir com npm run test:e2e:prod depois de mexer aqui).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
