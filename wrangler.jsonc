{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2026-10-01",
  // Só arquivos estáticos: o backend fica no Supabase (banco, auth e Edge Functions).
  "assets": {
    "directory": "./dist",
    // Rotas do React Router (/perfil, /reset-password...) devolvem o index.html ao recarregar.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
