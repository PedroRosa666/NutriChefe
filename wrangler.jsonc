{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2026-10-01",
  // Só arquivos estáticos: o backend fica no Supabase (banco, auth e Edge Functions).
  "assets": {
    "directory": "./dist",
    // Rotas do React Router (/perfil, /reset-password...) devolvem o index.html ao recarregar.
    "not_found_handling": "single-page-application"
  },
  // Domínio próprio (zona na mesma conta da Cloudflare). O "www" abre o app, que leva ao endereço
  // sem "www" (src/main.tsx).
  // Com domínio próprio o workers.dev desliga sozinho: fica ligado para os links antigos (e-mails,
  // app instalado), e o app leva quem chega por ele ao domínio próprio.
  "workers_dev": true,
  "routes": [
    { "pattern": "nutrichef.app.br", "custom_domain": true },
    { "pattern": "www.nutrichef.app.br", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
